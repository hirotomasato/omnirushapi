# Copy to .env and fill in. `npm start` and `npm run gateway` load it when it exists
# (node --env-file-if-exists); anything else reads the real environment.
# Everything has a default except ADMIN_TOKEN, which the gateway mints into the database
# on first start and prints once.

# HOST=127.0.0.1
# PORT=8787
# DB_PATH=data/gateway.db
# ADMIN_TOKEN=
# ROUTING=round-robin
# MAX_ATTEMPTS=3
# UPSTREAM_TIMEOUT_MS=600000
# COOLDOWN_MS=60000
# DEAD_COOLDOWN_MS=3600000
# CATALOG_CACHE_MS=60000
# LOG_LEVEL=info
# UPSTREAM_PROXY=http://proxy.example:8080   # falls back to HTTPS_PROXY/HTTP_PROXY/ALL_PROXY
# CURL_BIN=curl
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=change-me                # a placeholder is refused when HOST is not loopback
